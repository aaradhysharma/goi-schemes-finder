generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model SavedScheme {
  id         String    @id
  userEmail  String?
  sessionId  String?
  schemeId   String
  schemeName String
  category   String
  notes      String?
  appliedAt  DateTime?
  status     String    @default("saved")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([schemeId])
  @@index([sessionId])
  @@index([userEmail])
}

model SchemeApplication {
  id            String    @id
  userEmail     String?
  sessionId     String?
  schemeId      String
  schemeName    String
  applicationId String?
  status        String    @default("draft")
  documents     String[]
  notes         String?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sessionId])
  @@index([userEmail])
}

model UserProfile {
  id            String   @id
  email         String?  @unique
  sessionId     String?  @unique
  businessName  String?
  state         String?
  category      String?
  businessStage String?
  employeeCount Int?
  annualRevenue String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Scheme {
  id                 String   @id @default(cuid())
  name               String
  shortName          String
  ministry           String
  description        String
  benefits           String[]
  maxBenefit         String
  eligibility        Json
  applicationProcess String[]
  documents          String[]
  officialUrl        String
  deadline           String?
  featured           Boolean  @default(false)
  category           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("schemes")
}
